# ── Bot ───────────────────────────────────────────────────────────────────────
BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
# In docker-compose the bot's DATABASE_URL is set from POSTGRES_PASSWORD
# automatically. REQUIRED — docker-compose now fails fast if unset (no
# insecure default). Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change_me_generate_a_real_secret
DATABASE_URL=postgresql+asyncpg://testova:change_me_generate_a_real_secret@localhost:5432/testova_db

# ── Redis (FSM storage) ───────────────────────────────────────────────────────
# REQUIRED — docker-compose passes this to redis-server --requirepass and
# fails fast if unset. Generate with the same command as above.
REDIS_PASSWORD=change_me_generate_a_real_secret
REDIS_URL=redis://:change_me_generate_a_real_secret@localhost:6379/0

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Gemini cost tracking (read-only /usage). Prices are USD per 1M tokens.
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50
UZS_PER_USD=12000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
# Telegram's cloud Bot API caps a bot's getFile DOWNLOAD at 20 MB (see
# config.py's comment) — 50 passed upload pre-checks only to fail at download.
MAX_FILE_SIZE_MB=20
# Page cap for TEXTBOOK analysis only. The test-upload flow keeps its own
# MAX_PAGES=20 (a module constant) — do not conflate the two.
MAX_BOOK_PAGES=400

# ── Access control ─────────────────────────────────────────────────────────────
# Telegram IDs auto-promoted to admin on /start.
# MUST be a JSON array (brackets required) — a bare/comma-separated value
# crashes the bot at startup.
ADMIN_IDS=[123456789]
# Admin handle shown in the blocked/expired message (WITHOUT the leading @).
ADMIN_USERNAME=your_admin_username

# ── Admin web panel (HTML dashboard — app/admin/web) ────────────────────────
# Single-admin session-cookie login, undocumented here until now (AUDIT B-40) —
# a fresh deploy silently got ADMIN_PASSWORD_HASH="" (login disabled, the page
# says so — fail-closed, not a security hole) with no signal anything was
# missing. The password is stored ONLY as a bcrypt hash — generate it with
# `python -m app.admin.web.security <password>` and paste the output below.
# Never a blank/default password. Leave ADMIN_PASSWORD_HASH empty to disable
# the panel entirely.
ADMIN_PANEL_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Signs the session cookie — set a long random value in production. Empty =
# an ephemeral per-boot key, which simply logs everyone out on every restart.
ADMIN_SESSION_SECRET=
# Comma-separated proxy IPs whose X-Forwarded-For the admin panel will trust.
# EMPTY (the default) = trust nothing, so the login lockout sees the real TCP
# peer. Set this ONLY to the address of a reverse proxy you actually run
# (e.g. 127.0.0.1 for nginx on the same host) — leaving it empty behind a proxy
# collapses all clients to the proxy's IP, while trusting a proxy you do not
# run lets anyone spoof the header and bypass the lockout (AUDIT B-10).
ADMIN_TRUSTED_PROXIES=
# Reconciliation alert: flag Google's bill when it exceeds our computed cost by more than this many USD (alongside RECON_TOLERANCE_PCT).
RECON_TOLERANCE_USD=1.0
# Fresh-user trial applied on first /start: window in days + free full cycles +
# free answer-sheet checks.
TRIAL_DAYS=30
TRIAL_USES=1
TRIAL_CHECK_LIMIT=2

# ── Webhook mode (OPTIONAL — leave WEBHOOK_URL empty to run polling) ──────────
# Setting WEBHOOK_URL switches the bot from polling to an aiohttp server on
# 0.0.0.0:8080. WEBHOOK_SECRET is then MANDATORY and the bot refuses to start
# without it (AUDIT B-9): aiogram authenticates EVERY request when the secret is
# empty, so an open webhook accepts forged updates carrying any sender id —
# including an admin's, which reaches /grant and /broadcast.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the SAME value here and in setWebhook.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
